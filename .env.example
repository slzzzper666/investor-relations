# 法說會自動整理系統 — 環境變數範本
# 本地：複製成 .env 填入真實值（.env 已在 .gitignore，不會進版控）
# Railway：不需要 .env 檔，直接在 Service → Variables 設定同名變數即可
#（config.py 的 load_dotenv 在沒有 .env 時會自動 fallback 到系統環境變數）

# ===== 必填 =====

# Google Gemini API Key（STT 逐字稿 + AI 分析）
GEMINI_API_KEY=

# Notion Integration Token（secret_ 開頭）
NOTION_API_KEY=

# 既有 Notion 資料庫的 ID（程式直接寫入這個資料庫，需先建好欄位：
# 公司/股票代號/日期/簡報/YT/逐字稿/重點摘要/AI 觀點與未來方向分析）
NOTION_PARENT_ID=

# ===== 推播（至少填一組，否則只寫 Notion 不推播）=====

# Telegram Bot Token 與目標 Chat ID
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Discord Webhook URL
DISCORD_WEBHOOK_URL=

# ===== 選填 =====

# 填了就優先用 Groq Whisper 做 STT（不填則用 Gemini）
GROQ_API_KEY=

# 保留欄位：config.py 有定義但目前程式未使用，可不填
NOTION_DATABASE_ID=

# 直連失敗時的備援 Proxy（公司內網用；Railway 雲端直連可通，不需設定）
FALLBACK_PROXY=

# ===== 財報雷達子系統（radar.py）選填 =====
# 皆可不填：資料來源（Nasdaq/yfinance/Investing.com）目前免 key；
# 以下僅為日後接官方備援源預留，未填不影響運作。
FRED_API_KEY=
ALPHA_VANTAGE_KEY=
